# Supabase project settings (Project Settings -> API).
# The service-role key is used ONLY on the server (Server Components / Server Actions).
# Never prefix it with NEXT_PUBLIC_ and never import lib/supabase/server.ts from a client component.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Login for the owner dashboard (HTTP Basic Auth, enforced in proxy.ts).
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-me-to-something-long

# Display name used in WhatsApp reminder messages.
GYM_NAME=Iron Temple Gym

# IANA timezone used to decide what "today" is for expiry checks.
GYM_TIMEZONE=Asia/Kolkata

# ISO currency code for fees and salaries (INR, USD, AED, ...).
GYM_CURRENCY=INR
